-- -- "8 4 4 5 2 2 3 2"
-- -- vox 1 2
d6 $ layer [id, fast 2, jux rev]
$ every 2 (iter 2 . scramble 2)
$ splice 32 "8 4 4 5 2 2 3 2" $ sound "vox-general:1"
-- # speed 1.4
# djf 0.4
# lpf 1500
# gain (range 0.95 1.1 sine)
# gain "0.75"
# freeze "1"

-- layer / offset? speed?
d7 $ off 0.25 (slow 4) $ layer [id, fast 2, jux rev]
$ every 2 (slow 2 . scramble 2 ) $ fast 2
$ every 4 (rev . degradeBy 0.5)
$ every 2 (chunk 4 (iter 2 . scramble 2)) $ splice 32 "8 12 14 11 20 17 9 0" $ sound "vox-general:1"
-- # speed 2
# djf 0.4 # lpf 1500
# gain (range 0.85 0.6 $ slow 2 sine)
# pan sine
# gain 0.4

d7 silence


d7 silence

d5 $ layer [id, slow 2 . striate 2] $ fast 2 $ n "0*2 " # sound "soskick" # amp "0.3" # djf 0.8


