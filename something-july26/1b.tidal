setcps 0.6

hush

do
  d15 silence
  d16 silence

  do
    d10 silence


do
d6 $ fast 2 $ spread ($)[striate 4, rev] $ n "[~ <2 2*2> ~ 3*4]" # sound "rave:6"
  -- # room 0.9
  # lpf 1500
  # octave "5 4"
  # gain 1.1
d14 $ every 3 (hurry 2) $ striate "2" $ chunk 4 (|-| note 5) $ sometimes (jux rev) $ n "<2 5 7>"
  # sound "superchip"
  # gain "1.2 1.4"
  # sustain 3
  -- # gain 0.9
  # octave "<[5 4] [5 6]>"
  -- # octave 4


-- d1 $ fast 2 $ slice 4 "2 3 4 ~ ~  7 8 3" $ sound "voiceover" # cut 1
-- # gain "1 1.2"
-- # amp 1 # hpf 1000


-- //////////////////////



d4 $ fast 2 $ sometimes(scramble "2") $ n "[0 2 <3 1>]*4[<0 1>,5 5]*2"
# sound "gabor"
# gain 1.1
-- # freeze 1


d14 silence

d4
$ fast "2 4"
$ n "[0 2 <3 1>]*4[<0 1>,5 5]*2"
# sound "gabor"
-- # octave 6 # djf 0.7
-- # gain 0.9
